ue", 1177.46, 1177.78, 0.783], ["to", 1177.78, 1177.96, 0.992], ["hold", 1177.96, 1178.16, 0.948], ["the", 1178.16, 1178.34, 0.774], ["stock.", 1178.34, 1178.6, 0.936]]}, {"start": 1180.02, "end": 1183.58, "text": "Overall the large term trend has been sideways for the stock after a good correction.", "words": [["Overall", 1180.02, 1180.46, 0.857], ["the", 1180.46, 1180.68, 0.676], ["large", 1180.68, 1180.9, 0.469], ["term", 1180.9, 1181.08, 0.009], ["trend", 1181.08, 1181.32, 0.961], ["has", 1181.32, 1181.54, 0.988], ["been", 1181.54, 1181.7, 0.995], ["sideways", 1181.7, 1182.1, 0.962], ["for", 1182.1, 1182.38, 0.962], ["the", 1182.38, 1182.5, 0.981], ["stock", 1182.5, 1182.68, 0.998], ["after", 1182.68, 1182.94, 0.817], ["a", 1182.94, 1183.08, 0.603], ["good", 1183.08, 1183.18, 0.932], ["correction.", 1183.18, 1183.58, 0.979]]}, {"start": 1184.1, "end": 1186.08, "text": "But I am expecting a good recovery from the current level.", "words": [["But", 1184.1, 1184.2, 0.987], ["I", 1184.2, 1184.28, 0.994], ["am", 1184.28, 1184.4, 0.712], ["expecting", 1184.4, 1184.68, 0.993], ["a", 1184.68, 1184.9, 0.971], ["good", 1184.9, 1185.02, 0.848], ["recovery", 1185.02, 1185.34, 0.945], ["from", 1185.34, 1185.6, 0.968], ["the", 1185.6, 1185.74, 0.909], ["current", 1185.74, 1185.9, 0.953], ["level.", 1185.9, 1186.08, 0.445]]}, {"start": 1186.08, "end": 1188.7, "text": "Next query is from Ishwar from Kolkata.", "words": [["Next", 1186.08, 1186.92, 0.294], ["query", 1186.92, 1187.22, 0.066], ["is", 1187.22, 1187.44, 0.718], ["from", 1187.44, 1187.54, 0.978], ["Ishwar", 1187.54, 1187.88, 0.54], ["from", 1187.88, 1188.18, 0.918], ["Kolkata.", 1188.18, 1188.7, 0.949]]}, {"start": 1189.34, "end": 1193.32, "text": "He is holding few shares of TEMSEN's India, bought at a price of 542.", "words": [["He", 1189.34, 1189.8, 0.767], ["is", 1189.8, 1190.0, 0.89], ["holding", 1190.0, 1190.4, 0.993], ["few", 1190.4, 1190.66, 0.903], ["shares", 1190.66, 1190.9, 0.981], ["of", 1190.9, 1191.1, 0.