7.85, 0.98]]}, {"start": 1038.21, "end": 1043.19, "text": "And the fact that of course the stocks are doing well for themselves as well after plenty", "words": [["And", 1038.21, 1038.29, 0.962], ["the", 1038.29, 1038.43, 0.997], ["fact", 1038.43, 1038.71, 0.998], ["that", 1038.71, 1039.15, 0.99], ["of", 1039.15, 1039.45, 0.737], ["course", 1039.45, 1039.61, 0.998], ["the", 1039.61, 1040.15, 0.477], ["stocks", 1040.15, 1040.83, 0.968], ["are", 1040.83, 1041.15, 0.994], ["doing", 1041.15, 1041.39, 0.998], ["well", 1041.39, 1041.63, 0.996], ["for", 1041.63, 1041.85, 0.993], ["themselves", 1041.85, 1042.11, 0.995], ["as", 1042.11, 1042.43, 0.973], ["well", 1042.43, 1042.57, 0.998], ["after", 1042.57, 1042.85, 0.664], ["plenty", 1042.85, 1043.19, 0.86]]}, {"start": 1043.19, "end": 1045.97, "text": "of business updates that came in just full of dhabar as well.", "words": [["of", 1043.19, 1043.41, 0.998], ["business", 1043.41, 1043.67, 0.998], ["updates", 1043.67, 1044.05, 0.995], ["that", 1044.05, 1044.53, 0.915], ["came", 1044.53, 1044.73, 0.994], ["in", 1044.73, 1044.91, 0.977], ["just", 1044.91, 1045.03, 0.648], ["full", 1045.03, 1045.23, 0.295], ["of", 1045.23, 1045.33, 0.942], ["dhabar", 1045.33, 1045.63, 0.278], ["as", 1045.63, 1045.83, 0.989], ["well.", 1045.83, 1045.97, 0.997]]}, {"start": 1045.97, "end": 1048.95, "text": "That one also reacted to its business update a few minutes ago.", "words": [["That", 1045.97, 1046.23, 0.995], ["one", 1046.23, 1046.37, 0.976], ["also", 1046.37, 1046.73, 0.995], ["reacted", 1046.73, 1047.13, 0.995], ["to", 1047.13, 1047.39, 0.998], ["its", 1047.39, 1047.53, 0.747], ["business", 1047.53, 1047.75, 0.996], ["update", 1047.75, 1048.13, 0.952], ["a", 1048.13, 1048.29, 0.997], ["few", 1048.29, 1048.43, 0.999], ["minutes", 1048.43, 1048.61, 0.998], ["ago.", 1048.61, 1048.95, 0.998]]}, {"start": 1048.95, "end": 1052.63, "text": "And the stock was up around 3-3 and a half percent.", "words": [["And", 1048.95, 1049.63, 0.047], ["the", 1